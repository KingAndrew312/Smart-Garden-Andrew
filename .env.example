# Salin menjadi .env lalu sesuaikan

# ===== InfluxDB (dipakai docker compose untuk setup awal & oleh app) =====
INFLUX_USERNAME=admin
INFLUX_PASSWORD=ganti-password-minimal-8-karakter
INFLUX_ORG=smart-garden
INFLUX_BUCKET=garden
# Token bebas, buat yang panjang & acak, mis. hasil: openssl rand -hex 32
INFLUX_TOKEN=ganti-dengan-token-acak

# ===== Hanya untuk `npm start` di laptop (di Docker sudah diatur docker-compose.yml) =====
# Kosongkan INFLUX_URL = data disimpan di memori (testing)
# INFLUX_URL=http://localhost:8086
# MQTT_URL=mqtt://47.254.170.208:1883
# MQTT_WS_URL=ws://47.254.170.208/mqtt
MQTT_TOPIC=binus/garden/sensor/data

# false = server tidak ikut menyimpan data MQTT (mis. listener dijalankan terpisah)
MQTT_LISTENER=true
