# Salin menjadi .env lalu sesuaikan
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=andrew

# MQTT (default sudah sama dengan ESP32)
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_TOPIC=binus/garden/sensor/data

# false = server tidak ikut menyimpan data MQTT (mis. listener dijalankan terpisah)
MQTT_LISTENER=true
